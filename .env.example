# ===== Shared (set on BOTH Wispbyte and Vercel) =====
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres   # Supabase -> Project Settings -> Database -> Connection string (use the pooler URL on Vercel)
AUTH_CODE_SECRET=CHANGE_ME_random_string_at_least_32_chars    # MUST be identical on bot and dashboard. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
DASHBOARD_URL=https://your-dashboard.vercel.app               # public URL of the dashboard (https in production)

# ===== Bot only (Wispbyte) =====
DISCORD_TOKEN=PUT_BOT_TOKEN_HERE_IN_HOST_PANEL_ONLY           # Discord Developer Portal -> Bot -> Reset Token
DISCORD_CLIENT_ID=000000000000000000                          # Developer Portal -> General Information -> Application ID
DISCORD_GUILD_ID=                                             # optional: your test server ID; instant command registration for dev
OWNER_DISCORD_IDS=                                            # optional: comma-separated Discord user IDs always allowed
PORT=3001                                                     # health check port (/health and /ready)
