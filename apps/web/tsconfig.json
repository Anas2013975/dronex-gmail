{
 "extends": "../../tsconfig.base.json",
 "compilerOptions": {
  "jsx": "preserve",
  "lib": [
   "dom",
   "dom.iterable",
   "ES2022"
  ],
  "plugins": [
   {
    "name": "next"
   }
  ],
  "allowJs": false,
  "incremental": true,
  "paths": {
   "@/*": [
    "./src/*"
   ]
  }
 },
 "include": [
  "next-env.d.ts",
  "src",
  "tests",
  ".next/types/**/*.ts"
 ],
 "exclude": [
  "node_modules"
 ]
}